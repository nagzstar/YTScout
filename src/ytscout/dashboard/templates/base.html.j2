<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>YT Scout</title>
<style>
/* Plain on purpose: edit by hand. No external fonts, stylesheets or images. */
:root {
  --bg: #fafafa;
  --fg: #1d1d1f;
  --muted: #6b6b70;
  --line: #dcdce0;
  --panel: #ffffff;
  --accent: #2563eb;
  /* Categorical series, fixed order (the dataviz skill's validated palette). */
  --series-1: #2a78d6; --series-2: #eb6834; --series-3: #1baf7a; --series-4: #eda100;
  --series-5: #e87ba4; --series-6: #008300; --series-7: #4a3aa7; --series-8: #e34948;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #17171a;
    --fg: #e8e8ea;
    --muted: #9a9aa2;
    --line: #34343a;
    --panel: #1f1f23;
    --accent: #6d9bff;
    --series-1: #3987e5; --series-2: #d95926; --series-3: #199e70; --series-4: #c98500;
    --series-5: #d55181; --series-6: #008300; --series-7: #9085e9; --series-8: #e66767;
  }
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--fg);
  font: 15px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
header, main { max-width: 1100px; margin: 0 auto; padding: 0 16px; }
header { padding-top: 16px; padding-bottom: 8px; border-bottom: 1px solid var(--line); }
header h1 { font-size: 20px; margin: 0 0 6px; }
.facts { display: flex; flex-wrap: wrap; gap: 6px 24px; margin: 0; color: var(--muted); }
.facts dt { display: inline; }
.facts dd { display: inline; margin: 0 0 0 4px; color: var(--fg); font-variant-numeric: tabular-nums; }
nav { margin-top: 10px; display: flex; gap: 16px; flex-wrap: wrap; }
nav a { color: var(--accent); text-decoration: none; }
nav a:hover { text-decoration: underline; }
section { margin: 28px 0; }
h2 { font-size: 18px; margin: 0 0 10px; }
h3 { font-size: 15px; margin: 18px 0 8px; }
.empty { color: var(--muted); font-style: italic; }
.panel { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 12px; }
.chart { position: relative; height: 260px; }
.table-wrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; background: var(--panel); }
th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
th { font-weight: 600; color: var(--muted); white-space: nowrap; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
td a { color: var(--accent); }
ul.reasons { margin: 0; padding-left: 18px; color: var(--muted); font-size: 13px; }
.actions { white-space: nowrap; }
button { font: inherit; font-size: 13px; padding: 2px 8px; margin-right: 4px; }
button:disabled { cursor: not-allowed; }
.muted { color: var(--muted); font-size: 13px; }
tr.own td { font-weight: 700; }
.toggle { display: inline-flex; gap: 0; margin: 4px 0 4px; }
.toggle button { margin: 0; border: 1px solid var(--line); background: var(--panel); color: var(--fg); padding: 3px 12px; }
.toggle button[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: #fff; }
details { margin-top: 8px; }
summary { cursor: pointer; color: var(--muted); font-size: 13px; }
.note { background: var(--panel); border: 1px solid var(--accent); border-radius: 6px; padding: 8px 12px; }
/* Findings (017) */
ol.next-videos { padding-left: 22px; }
li.next-video { margin: 8px 0; }
li.next-video p { margin: 4px 0; }
ul.evidence { margin: 2px 0 0; padding-left: 18px; font-size: 13px; }
ul.evidence a { color: var(--accent); }
ul.observations { margin: 0; padding-left: 18px; }
ul.observations li { margin: 4px 0; }
.competitor-card { margin: 10px 0; }
.competitor-card h4 { margin: 0 0 6px; font-size: 15px; }
.competitor-card h5 { margin: 10px 0 4px; font-size: 13px; color: var(--muted); font-weight: 600; }
/* Niches (025) */
.niche-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; margin: 4px 0 8px; }
.niche-controls input { width: 5em; font: inherit; }
th.sortable button.sort { background: none; border: 0; padding: 0; font: inherit; color: inherit; cursor: pointer; text-decoration: underline dotted; }
th.sortable[aria-sort="ascending"] button.sort::after { content: " \25B2"; }
th.sortable[aria-sort="descending"] button.sort::after { content: " \25BC"; }
button.expand { border: none; background: none; color: var(--muted); padding: 0 4px 0 0; margin: 0; cursor: pointer; }
.badge { display: inline-block; font-size: 11px; line-height: 1.5; padding: 0 6px; margin: 0 4px 2px 0; border-radius: 9px; border: 1px solid var(--line); color: var(--muted); white-space: nowrap; }
.badge-disqualified { border-color: var(--series-8); color: var(--series-8); }
.badge-low_confidence { border-color: var(--series-4); color: var(--fg); }
.badge-weak_evidence { border-color: var(--series-4); color: var(--fg); }
.badge-reused_content_high { border-color: var(--series-8); color: var(--series-8); }
/* 055: reused-content risk column; a high row is shaded and marked, never hidden. */
td.risk { text-transform: capitalize; white-space: nowrap; }
td.risk-high { color: var(--series-8); font-weight: 600; }
td.risk-medium { color: var(--series-4); }
tr.niche-row.risk-high > td { background: color-mix(in srgb, var(--series-8) 10%, var(--bg)); }
td.risk .warn { font-weight: 400; }
td.trend { text-align: center; }
tr.niche-sample > td { background: var(--bg); }
.sample-grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 12px 24px; }
@media (max-width: 700px) { .sample-grid { grid-template-columns: minmax(0, 1fr); } }
.sample-grid h4 { margin: 4px 0 6px; font-size: 13px; color: var(--muted); font-weight: 600; }
ul.sample-channels { margin: 0; padding-left: 18px; }
.cov-automated { color: var(--series-6); }
.cov-manual { color: var(--series-8); }
.waiting table { color: var(--muted); }
.banner { background: var(--series-8); color: #fff; border-radius: 6px; padding: 8px 12px; margin: 12px 0; }
.banner a { color: #fff; }
.status-bad { color: var(--series-8); font-weight: 600; }
pre { white-space: pre-wrap; font-size: 12px; }
footer { max-width: 1100px; margin: 40px auto 24px; padding: 0 16px; color: var(--muted); font-size: 13px; }
</style>
</head>
<body>
<header>
  <h1>YT Scout</h1>
  <dl class="facts">
    <div><dt>Built</dt><dd>{{ d.built_at }}</dd></div>
    {% if d.own %}
    <div><dt>Channel</dt><dd>{{ d.own.title or d.own.id }}</dd></div>
    <div><dt>Subscribers</dt><dd>{{ d.own.subs | number }}</dd></div>
    {% else %}
    <div><dt>Channel</dt><dd>nothing yet (run <code>collect --own</code>)</dd></div>
    {% endif %}
    <div><dt>Quota today</dt><dd>{{ d.quota_today | number }} units</dd></div>
    <div><dt>Yesterday</dt><dd>{{ d.quota_yesterday | number }} units</dd></div>
    <div><dt>Niches</dt><dd>{{ d.niche_counts.get("scored", 0) }} niches scored · {{ d.niche_counts.get("tracking", 0) }} tracking · {{ d.niche_counts.get("shelved", 0) }} shelved</dd></div>
    <div><dt>Last run</dt><dd>
      {%- if d.last_run %}{{ d.last_run.kind }}: {{ d.last_run.status or "running" }} ({{ d.last_run.started_at }}){% else %}none yet{% endif -%}
    </dd></div>
  </dl>
  <nav>
    <a href="#own">Own channel</a>
    <a href="#competitors">Competitors</a>
    <a href="#side-by-side">Side by side</a>
    <a href="#niches">Niches</a>
    <a href="#findings">Findings</a>
    <a href="#runs">Runs</a>
  </nav>
</header>
<main>
{% if d.runs.banner %}
<div class="banner" id="runs-banner" role="alert"><strong>Needs attention:</strong> {{ d.runs.banner | join("; ") }}. <a href="#runs">See Runs</a>.</div>
{% endif %}
{% include "own.html.j2" %}
{% include "competitors.html.j2" %}
{% include "niches.html.j2" %}
{% include "findings.html.j2" %}
{% include "runs.html.j2" %}
</main>
<footer>Generated by <code>ytscout dashboard</code>. A static file: charts by Chart.js (MIT), inlined.</footer>
<script>
{{ chartjs | safe }}
</script>
<script>
(function () {
  "use strict";
  var el = document.getElementById("subs-data");
  var canvas = document.getElementById("subs-chart");
  if (!el || !canvas || typeof Chart === "undefined") { return; }
  var rows = JSON.parse(el.textContent);
  var css = getComputedStyle(document.documentElement);
  var accent = css.getPropertyValue("--accent").trim();
  var muted = css.getPropertyValue("--muted").trim();
  var line = css.getPropertyValue("--line").trim();
  new Chart(canvas, {
    type: "line",
    data: {
      labels: rows.map(function (r) { return r.captured_at.slice(0, 10); }),
      datasets: [{
        label: "Subscribers",
        data: rows.map(function (r) { return r.subs; }),
        borderColor: accent,
        backgroundColor: accent,
        borderWidth: 2,
        pointRadius: rows.length > 30 ? 0 : 3,
        tension: 0
      }]
    },
    options: {
      maintainAspectRatio: false,
      animation: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { ticks: { color: muted, maxTicksLimit: 8 }, grid: { color: line } },
        y: { ticks: { color: muted }, grid: { color: line } }
      }
    }
  });
})();
</script>
<script>
(function () {
  "use strict";
  // Units by Pacific day (031): one bar per day, zero days included.
  var el = document.getElementById("units-data");
  var canvas = document.getElementById("units-chart");
  if (!el || !canvas || typeof Chart === "undefined") { return; }
  var data = JSON.parse(el.textContent);
  var css = getComputedStyle(document.documentElement);
  var accent = css.getPropertyValue("--accent").trim();
  var muted = css.getPropertyValue("--muted").trim();
  var line = css.getPropertyValue("--line").trim();
  new Chart(canvas, {
    type: "bar",
    data: {
      labels: data.labels.map(function (d) { return d.slice(5); }),
      datasets: [{ label: "Units", data: data.units, backgroundColor: accent, borderRadius: 2 }]
    },
    options: {
      maintainAspectRatio: false,
      animation: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { ticks: { color: muted }, grid: { display: false } },
        y: { beginAtZero: true, ticks: { color: muted }, grid: { color: line } }
      }
    }
  });
})();
</script>
<script>
(function () {
  "use strict";
  // 90d / 365d toggle for the side-by-side tables.
  var buttons = document.querySelectorAll("button[data-window]");
  Array.prototype.forEach.call(buttons, function (btn) {
    btn.addEventListener("click", function () {
      var want = btn.getAttribute("data-window");
      Array.prototype.forEach.call(buttons, function (b) {
        b.setAttribute("aria-pressed", b === btn ? "true" : "false");
      });
      Array.prototype.forEach.call(document.querySelectorAll("[data-window-panel]"), function (p) {
        p.hidden = p.getAttribute("data-window-panel") !== want;
      });
    });
  });

  // Views by publish month: one line per channel, own first in series slot 1.
  var el = document.getElementById("monthly-data");
  var canvas = document.getElementById("monthly-chart");
  if (!el || !canvas || typeof Chart === "undefined") { return; }
  var data = JSON.parse(el.textContent);
  var css = getComputedStyle(document.documentElement);
  var muted = css.getPropertyValue("--muted").trim();
  var fg = css.getPropertyValue("--fg").trim();
  var line = css.getPropertyValue("--line").trim();
  var slot = 0;
  new Chart(canvas, {
    type: "line",
    data: {
      labels: data.labels,
      datasets: data.series.map(function (s) {
        var color = s.other ? muted : css.getPropertyValue("--series-" + (++slot)).trim();
        return {
          label: s.name,
          data: s.data,
          borderColor: color,
          backgroundColor: color,
          borderWidth: 2,
          borderDash: s.other ? [4, 3] : [],
          pointRadius: 4,
          pointHoverRadius: 6,
          tension: 0
        };
      })
    },
    options: {
      maintainAspectRatio: false,
      animation: false,
      interaction: { mode: "index", intersect: false },
      plugins: {
        legend: { position: "bottom", labels: { color: fg, boxWidth: 12 } },
        tooltip: {
          callbacks: {
            label: function (ctx) { return ctx.dataset.label + ": " + ctx.parsed.y.toLocaleString("en-GB"); }
          }
        }
      },
      scales: {
        x: { ticks: { color: muted }, grid: { color: line } },
        y: { beginAtZero: true, ticks: { color: muted }, grid: { color: line } }
      }
    }
  });
})();
</script>
<script>
(function () {
  "use strict";
  // Review buttons: POST to `ytscout serve`, then reload. Opened from file:// there is no
  // server to post to, so say how to start one instead.
  var HINT = "start `ytscout serve` and open http://127.0.0.1:8765/";
  var note = null;
  function say(text) {
    if (!note) { return; }
    note.textContent = text;
    note.hidden = false;
  }
  document.addEventListener("click", function (ev) {
    var btn = ev.target.closest ? ev.target.closest("button[data-decision]") : null;
    if (!btn) { return; }
    var section = btn.closest("section");
    note = (section && section.querySelector("p.note[role=status]")) || document.getElementById("serve-note");
    if (location.protocol !== "http:") { say(HINT); return; }
    btn.disabled = true;
    fetch("/decide", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ kind: btn.dataset.kind, id: btn.dataset.id, decision: btn.dataset.decision })
    }).then(function (resp) {
      return resp.json().then(function (body) {
        if (resp.ok && body.ok) { location.reload(); return; }
        say((body.saved ? "" : "Not saved: ") + (body.error || resp.status));
        btn.disabled = false;
      });
    }).catch(function () {
      say(HINT);
      btn.disabled = false;
    });
  });
})();
</script>
<script>
(function () {
  "use strict";
  // Niches (025): Shorts / Long-form toggle, "opportunity >=" filter, expandable sample rows.
  var buttons = document.querySelectorAll("button[data-niche-format]");
  Array.prototype.forEach.call(buttons, function (btn) {
    btn.addEventListener("click", function () {
      var want = btn.getAttribute("data-niche-format");
      Array.prototype.forEach.call(buttons, function (b) {
        b.setAttribute("aria-pressed", b === btn ? "true" : "false");
      });
      Array.prototype.forEach.call(document.querySelectorAll("[data-niche-format-panel]"), function (p) {
        p.hidden = p.getAttribute("data-niche-format-panel") !== want;
      });
    });
  });
  function detail(row) { return document.getElementById("niche-sample-" + row.getAttribute("data-niche-id")); }
  var input = document.getElementById("niche-min-opp");
  function filter() {
    var min = parseFloat(input.value);
    if (isNaN(min)) { min = 0; }
    Array.prototype.forEach.call(document.querySelectorAll("tr.niche-row"), function (row) {
      var hide = parseFloat(row.getAttribute("data-opportunity")) < min;
      row.hidden = hide;
      var more = detail(row);
      if (more && hide) { more.hidden = true; row.querySelector("button.expand").setAttribute("aria-expanded", "false"); }
    });
  }
  if (input) { input.addEventListener("input", filter); filter(); }
  // 054: sortable columns. Months to YPP ascending is the rendered order; "never" and
  // unknown rows stay last whichever way the column goes. Each niche row moves with its
  // sample row.
  function sortKey(row, by) {
    if (by === "score") { return parseFloat(row.getAttribute("data-score")) || 0; }
    var months = row.getAttribute("data-months-ypp");
    return months === "" ? null : parseFloat(months);
  }
  document.addEventListener("click", function (ev) {
    var head = ev.target.closest ? ev.target.closest("th.sortable") : null;
    if (!head) { return; }
    var table = head.closest("table");
    var by = head.getAttribute("data-sort");
    var dir = head.getAttribute("aria-sort") === "ascending" ? "descending" : "ascending";
    Array.prototype.forEach.call(table.querySelectorAll("th.sortable"), function (h) {
      h.setAttribute("aria-sort", h === head ? dir : "none");
    });
    var body = table.querySelector("tbody");
    var pairs = Array.prototype.map.call(body.querySelectorAll("tr.niche-row"), function (row) {
      return { row: row, more: detail(row), key: sortKey(row, by) };
    });
    pairs.sort(function (a, b) {
      if (a.key === null && b.key === null) { return 0; }
      if (a.key === null) { return 1; }
      if (b.key === null) { return -1; }
      return dir === "ascending" ? a.key - b.key : b.key - a.key;
    });
    pairs.forEach(function (p) { body.appendChild(p.row); if (p.more) { body.appendChild(p.more); } });
  });
  document.addEventListener("click", function (ev) {
    var btn = ev.target.closest ? ev.target.closest("button.expand") : null;
    if (!btn) { return; }
    var more = detail(btn.closest("tr"));
    if (!more) { return; }
    more.hidden = !more.hidden;
    btn.setAttribute("aria-expanded", more.hidden ? "false" : "true");
    btn.textContent = more.hidden ? "▸" : "▾";
  });
})();
</script>
</body>
</html>
