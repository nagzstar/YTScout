<section id="own">
  <h2>Own channel</h2>
  {% if not d.own %}
  <p class="empty">Nothing yet. Run <code>ytscout collect --own --max-units 20</code>.</p>
  {% else %}
  <h3>Subscribers over time</h3>
  {% if d.subs_series %}
  <div class="panel chart"><canvas id="subs-chart" aria-label="Subscribers over time" role="img"></canvas></div>
  <script type="application/json" id="subs-data">{{ d.subs_series | tojson }}</script>
  {% else %}
  <p class="empty">Nothing yet: no channel snapshots with a subscriber count.</p>
  {% endif %}
  <h3>Latest {{ d.own_videos | length }} videos</h3>
  {% if d.own_videos %}
  <div class="table-wrap">
  <table>
    <thead><tr>
      <th>Title</th><th>Published</th><th class="num">Duration</th>
      <th class="num">Views</th><th class="num">Likes</th><th class="num">Comments</th><th>Short?</th>
    </tr></thead>
    <tbody>
    {% for v in d.own_videos %}
      <tr>
        <td><a href="{{ watch_url }}{{ v.id | urlencode }}">{{ v.title or v.id }}</a></td>
        <td>{{ v.published_at | day }}</td>
        <td class="num">{{ v.duration_s | duration }}</td>
        <td class="num">{{ v.views | number }}</td>
        <td class="num">{{ v.likes | number }}</td>
        <td class="num">{{ v.comments | number }}</td>
        <td>{% if v.is_short is none %}–{% elif v.is_short %}yes{% else %}no{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <p class="empty">Nothing yet: no videos collected.</p>
  {% endif %}
  {% endif %}
</section>
