# Copy to .env and fill in. Never commit .env (it is gitignored).
# Loaded by ytscout.settings; a real environment variable with the same name wins.
# Issue 005 walks through where each value comes from.

# Required. YouTube Data API v3 key (public data). Restrict it to the Data API
# in Google Cloud Console → Credentials.
YT_API_KEY=

# YouTube Analytics API (OAuth desktop client, your own channel's private data).
# Relative paths resolve against the repo root. scripts/.secrets/ is gitignored.
# The client JSON comes from Google Cloud Console → Credentials → OAuth client ID
# (Desktop app). The token is written by `python -m ytscout auth` (issue 012).
YT_CLIENT_SECRET_PATH=scripts/.secrets/client_secret.json
YT_TOKEN_PATH=scripts/.secrets/token.json

# Required. Countdown Animal Kingdom's channel ID (starts with UC): YouTube
# Studio → Settings → Channel → Advanced. `own_channel_id` in
# config/settings.yaml overrides it if set.
YT_CHANNEL_ID=
