{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "niche_step_tagging",
  "description": "Which production steps each niche in a batch requires (prompts/niche_step_tagging.md). Step ids are the fixed list in config/production_steps.yaml; tests/test_scout_score.py checks the enum matches that file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["niches"],
  "properties": {
    "niches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["niche_id", "required_steps", "needs_specific_footage", "notes"],
        "properties": {
          "niche_id": { "type": "integer", "minimum": 1 },
          "required_steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "string",
              "enum": [
                "research",
                "script",
                "voiceover",
                "visuals_stock",
                "footage_original",
                "presenter",
                "assembly",
                "thumbnail",
                "metadata",
                "upload",
                "qa",
                "community"
              ]
            }
          },
          "needs_specific_footage": { "type": "boolean" },
          "notes": { "type": "string", "maxLength": 300 }
        }
      }
    }
  }
}
